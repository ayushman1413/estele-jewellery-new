<IfModule mod_rewrite.c>
    RewriteEngine On

    # Redirect all requests to the public/ subdirectory.
    # Required for shared hosting (Hostinger) where the Laravel project
    # root is placed directly inside public_html/.
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ /public/$1 [L]
</IfModule>
